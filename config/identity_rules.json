{
  "version": 2,
  "frequency_semantics": "Danbooru related_tags.frequency for character + solo; sampled co-occurrence, not canonical truth; solo reduces other-character contamination but does not exclude cosplay or tagging errors",
  "min_frequency": 0.4,
  "candidate_min_frequency": 0.15,
  "exclusive_min_gap": 0.15,
  "exclusive_min_ratio": 1.5,
  "categories": [
    {
      "name": "hair_color",
      "pattern": "^(?:black|white|grey|gray|silver|blonde|brown|red|orange|yellow|green|blue|purple|pink|aqua|multicolored|two-tone)_hair$",
      "exclusive": true
    },
    {
      "name": "eye_color",
      "pattern": "^(?:black|white|grey|gray|silver|brown|red|orange|yellow|green|blue|purple|pink|aqua|heterochromia)_eyes$|^heterochromia$",
      "exclusive": true
    },
    {
      "name": "hair_length",
      "pattern": "^(?:short|medium|long|very_long)_hair$",
      "exclusive": true
    },
    {
      "name": "hairstyle",
      "pattern": "^(?:(?:single|double)_hair_bun|hair_bun|twintails|low_twintails|ponytail|side_ponytail|braid|twin_braids)$",
      "exclusive": true
    },
    {
      "name": "hair_details",
      "pattern": "^(?:bangs|blunt_bangs|parted_bangs|sidelocks|long_sidelocks|ahoge|hair_over_one_eye|hair_between_eyes|hime_cut)$",
      "exclusive": false
    },
    {
      "name": "features",
      "pattern": "^(?:pointy_ears|elf|horns|animal_ears|fang|freckles|mole|mole_under_eye|glasses|rimless_eyewear|semi-rimless_eyewear)$",
      "exclusive": false
    },
    {
      "name": "accessory_color",
      "pattern": "^(?:black|white|red|blue|green|yellow|purple|pink|gold|silver)_(?:hairband|earrings|ribbon|hair_ribbon|hair_bow|bow)$",
      "exclusive_by_suffix": true
    },
    {
      "name": "accessories",
      "pattern": "^(?:hairband|earrings|jewelry|hair_ornament|hair_ribbon|hair_bow|hairclip|headband|necklace|choker)$",
      "exclusive": false
    },
    {
      "name": "outfit_base",
      "pattern": "^(?:dress|sweater_dress|shirt|sweater|bodysuit|leotard|kimono|robe|uniform|suit|coat|jacket)$",
      "exclusive": true,
      "outfit": true
    },
    {
      "name": "outfit_parts",
      "pattern": "(?:^|_)(?:buttons?|footwear|skirt_set|shirt|jacket|skirt|belt|capelet|cape|collar|pantyhose|boots?|shoes?|dress|coat|cloak|robe|uniform|socks?|gloves?|hat|scarf|ribbon|gem|trim|vest|necktie|sweater|sleeves|thighhighs|bow|apron)(?:_|$)",
      "exclusive_by_suffix": true,
      "outfit": true
    }
  ],
  "outfit_incompatible_groups": [
    [
      "dress",
      "bodysuit",
      "kimono",
      "suit"
    ],
    [
      "short_sleeves",
      "long_sleeves",
      "sleeveless"
    ],
    [
      "pantyhose",
      "thighhighs",
      "knee_socks"
    ]
  ],
  "wiki_variant_markers": "\\b(?:when|alternatively|alternate|sometimes|occasionally|instead|different|other)\\b|\\bas an?\\b",
  "neutral_l2_tags": "solo, standing, looking_at_viewer, simple_background",
  "lora": {
    "strength_model": 0.8,
    "strength_clip": 0.8,
    "min_training_count": 1,
    "min_character_share": 0.8,
    "non_final_pattern": "(?:eval|validation|checkpoint|intermediate|(?:step|epoch)[_ -]*\\d+)",
    "style_coexistence": "character loaded after fixed style LoRAs; identity priority; adjust weights only with recorded diagnosis"
  },
  "references": {
    "count": 3,
    "min_score": 20,
    "query_suffix": "",
    "candidate_limit": 100,
    "require_solo": true,
    "require_full_body": false,
    "max_pages": 5,
    "policy_version": 2,
    "directory": "references_v2",
    "exclude_tags": [
      "chibi",
      "meme",
      "english_text",
      "speech_bubble",
      "text_focus",
      "text_only",
      "comic",
      "cosplay",
      "alternate_costume",
      "sketch",
      "monochrome",
      "greyscale",
      "genderswap",
      "aged_down",
      "aged_up"
    ],
    "eyewear_tags": [
      "glasses",
      "sunglasses",
      "goggles",
      "rimless_eyewear",
      "semi-rimless_eyewear",
      "eyewear"
    ],
    "eyewear_patterns": [
      "(?:^|_)eyewear$",
      "(?:^|_)glasses$"
    ],
    "selection_order": [
      "appearance_coverage_desc",
      "default_outfit_coverage_desc",
      "score_desc",
      "post_id_asc"
    ]
  },
  "related_query_suffix": "solo",
  "compatible_tag_groups": [
    [
      "long_hair",
      "very_long_hair"
    ],
    [
      "dress",
      "sweater_dress"
    ]
  ],
  "outfit_selection": {
    "component_min_frequency": 0.25,
    "description_pattern": "\\b(?:wears?|wearing|wore|dons?|donned|dressed|clothing|costume|outfit)\\b",
    "new_ensemble_pattern": "\\b(?:when dressed|dressed as|alternatively|alternate|instead|in the past)\\b",
    "continuation_pattern": "^(?:over|under|she also|he also|they also|also|when outdoors)\\b",
    "historical_pattern": "\\b(?:in the past|previously|formerly|used to)\\b|\\[\\[aged down(?:\\||\\]\\])",
    "base_families": [
      "sweater_dress",
      "dress",
      "shirt",
      "sweater",
      "bodysuit",
      "leotard",
      "kimono",
      "robe",
      "uniform",
      "suit",
      "coat",
      "jacket"
    ],
    "layer_families": [
      "coat",
      "jacket"
    ],
    "tie_break": "wiki order",
    "missing_frequency": "unavailable; ranks after measured frequencies",
    "wiki_policy": "lock whole selected ensemble from wiki sentences, independently of identity appearance conflicts"
  },
  "tier_probe": {
    "framing": "full",
    "seed": 60101,
    "max_tests": 1,
    "max_vision_calls": 6,
    "max_seconds": 600,
    "input_policy": "character tag + work tag + neutral composition; L1 adds matched LoRA and triggers only"
  },
  "tier_review": {
    "version": 3,
    "tier_scope": "appearance_only",
    "outfit_policy": "diagnostic only for L1/L2; setting portrait separately validates applicable clothing",
    "image_order": [
      "generated_test",
      "danbooru_reference"
    ],
    "required_observations": [
      "test_observation",
      "reference_observation"
    ],
    "confirmation_policy": "all reliable appearance items pass; any appearance fail vetoes; not_visible neither vetoes nor confirms",
    "aggregation_policy": "D8b",
    "l1_protocol": "matched dedicated LoRA plus sourced identity tags",
    "l2_protocol": "canonical character and work tags plus neutral composition only"
  },
  "generation_identity_control": {
    "mechanism": "ipadapter",
    "ipadapter_strength": 0.4
  },
  "l3": {
    "max_attempts": 3,
    "weights": [
      0.55,
      0.65,
      0.75
    ],
    "diagnosis_reason": "Knowledge probe vetoed by sourced feature comparison; strengthen face reference only for diagnosed appearance failures, and reinforce sourced clothing for outfit failures. No seed-only retries.",
    "max_seconds": 900,
    "max_vision_calls": 18,
    "outfit_weights": [
      1.0,
      1.2,
      1.4
    ]
  }
}
